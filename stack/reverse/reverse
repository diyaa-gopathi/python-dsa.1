#include <stdio.h>
#include <stdlib.h>

void reverseString(char* s, int sSize) {
    // start your solution
    int left = 0;
    int right = sSize - 1;

    while (left < right) {
        char temp = s[left];
        s[left] = s[right];
        s[right] = temp;

        left++;
        right--;
    }
    // end your solution
}

int main() {
    int n;
    scanf("%d", &n);

    char* s = (char*)malloc(n * sizeof(char));

    for (int i = 0; i < n; i++) {
        scanf(" %c", &s[i]);
    }

    reverseString(s, n);

    for (int i = 0; i < n; i++) {
        printf("%c", s[i]);
        if (i < n - 1) printf(" ");
    }
    printf("\n");

    free(s);
    return 0;
}